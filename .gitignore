# Reels: the frame captures are rebuildable from tools/reel and far too large
# to keep in the repository. `broll` is footage that belongs to whoever shot
# it. The encoded videos no longer land here at all — they go to ~/Videos, or
# wherever REELS_DIR points — but the rule stays, because an older checkout or
# an explicit REELS_DIR=reels would put them back.
reels
broll

# Throwaway browser-driving scratch scripts. Anything in tools/ starting with
# an underscore is a one-off probe written to answer a single question while
# clicking through a dashboard, not something the project builds on.
tools/_*.mjs
