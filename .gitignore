node_modules
dist
.DS_Store
*.local
# The tools in tools/ write their captures here. Anchored, because
# a bare `shots` matches any directory of that name at any depth,
# which silently swallowed public/shots/, the landing page's renders.
/shots

.env
.env.local
dist
names.txt
free*.txt
coined.txt
err*.txt
cerr.txt

# Name-search scratch output
*free.txt
*err.txt
pairs.txt

