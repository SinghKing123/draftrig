# Twinbench — environment
#
# Both values are safe to expose in the browser. The anon key is designed to be
# public; row-level security in the database is what actually guards the data,
# and it is defined in supabase/schema.sql.
#
# Leave these unset and the app still runs — projects save to the browser and
# the account UI hides itself. Nothing breaks.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
