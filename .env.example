# Draftrig environment
#
# Every value here is safe to expose in the browser — they all end up in the
# JavaScript anyone can read. What guards the data is the row-level security in
# supabase/schema.sql, which the database enforces and no client can talk its
# way past.
#
# Leave them unset and the app still runs: the editor works, projects save to
# this browser, and the account UI hides itself. Nothing breaks.
#
# These are read at BUILD time, not run time. Setting them on a host after a
# deploy changes nothing until the site is built again.

# --- Sign-in (Auth0) -------------------------------------------------
# Tenant domain, e.g. draftrig.eu.auth0.com
VITE_AUTH0_DOMAIN=
# Application -> Settings -> Client ID
VITE_AUTH0_CLIENT_ID=
# Identifier of the API you registered in Auth0, e.g. https://api.draftrig.com
# Without this Auth0 returns a token Supabase cannot verify, and sign-in works
# right up until the first query comes back empty.
VITE_AUTH0_AUDIENCE=

# --- Data (Supabase) -------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
