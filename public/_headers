# Cloudflare Pages reads this from the root of the published directory.
#
# Vite fingerprints everything under /assets with a content hash, so those
# files can never change without changing their name: they are safe to cache
# forever, and caching them forever is what makes a repeat visit instant.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Model files are large and equally immutable once published. They are only
# fetched when a part that uses one is actually placed.
/models/*
  Cache-Control: public, max-age=604800

# index.html must never be cached hard, or a deploy goes out and browsers keep
# loading the old one, which points at asset names that no longer exist.
/index.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate
